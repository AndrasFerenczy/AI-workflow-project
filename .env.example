# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite file used by Prisma, relative to the project root. Keep it root-relative
# so the CLI and the runtime driver adapter resolve to the same file.
DATABASE_URL="file:./prisma/dev.db"

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------
# At least one provider key is required to run a workflow. Providers without a
# key are shown as unavailable in the builder instead of failing at run time.

# https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=""

# Optional: point the OpenAI adapter at a compatible gateway
# (OpenRouter, Groq, LM Studio, Ollama's /v1 endpoint, ...)
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Optional override for DeepSeek (defaults to https://api.deepseek.com)
# DEEPSEEK_BASE_URL="https://api.deepseek.com"

# ---------------------------------------------------------------------------
# Execution guardrails (optional, sensible defaults are built in)
# ---------------------------------------------------------------------------
# Hard ceiling on LLM<->tool round trips within a single agent step.
# WORKFLOW_MAX_ITERATIONS="8"
# Hard ceiling on steps executed per run, protects against decision loops.
# WORKFLOW_MAX_STEPS="25"
# Wall clock budget for a single run, in milliseconds.
# WORKFLOW_TIMEOUT_MS="120000"

# ---------------------------------------------------------------------------
# Docker (optional)
# ---------------------------------------------------------------------------
# When using docker compose, DATABASE_URL is overridden to file:/data/dev.db
# (named volume). Set this to false after the first start if you do not want
# the demo workflows re-seeded on every container restart.
# SEED_ON_START="true"
