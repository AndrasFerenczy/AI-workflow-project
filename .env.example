# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite file used by Prisma. The path is relative to the prisma/ directory.
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------
# At least one provider key is required to run a workflow. Providers without a
# key are shown as unavailable in the builder instead of failing at run time.

# https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Optional: point the OpenAI adapter at a compatible gateway
# (OpenRouter, Groq, LM Studio, Ollama's /v1 endpoint, ...)
# OPENAI_BASE_URL="https://api.openai.com/v1"

# ---------------------------------------------------------------------------
# Execution guardrails (optional, sensible defaults are built in)
# ---------------------------------------------------------------------------
# Hard ceiling on LLM<->tool round trips within a single agent step.
# WORKFLOW_MAX_ITERATIONS="8"
# Hard ceiling on steps executed per run, protects against decision loops.
# WORKFLOW_MAX_STEPS="25"
# Wall clock budget for a single run, in milliseconds.
# WORKFLOW_TIMEOUT_MS="120000"
